{
	"appId": "com.everyqrcodegenerator.app",
	"appName": "Every QRCode Generator Pro",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"url": "https://every-qrcode-generator-pro.netlify.app",
		"cleartext": true
	},
	"android": {
		"allowMixedContent": true,
		"captureInput": true,
		"webContentsDebuggingEnabled": true
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 2000,
			"launchAutoHide": true,
			"backgroundColor": "#6451F8",
			"androidSplashResourceName": "splash_background",
			"showSpinner": false
		}
	}
}
