<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Only allow HTTPS in production -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">every-qrcode-generator-pro.netlify.app</domain>
        <domain includeSubdomains="true">girbzspzntlkindeopcy.supabase.co</domain>
    </domain-config>

    <!-- Allow cleartext for local dev only in debug builds -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
