<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base security configuration allowing HTTPS and system certificates -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Specific domain rules -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">every-qrcode-generator-pro.netlify.app</domain>
        <domain includeSubdomains="true">girbzspzntlkindeopcy.supabase.co</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
