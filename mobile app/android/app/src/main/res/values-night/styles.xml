<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark Theme (Material3) -->
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#8B7BFF</item>
        <item name="colorPrimaryVariant">#6451F8</item>
        <item name="colorOnPrimary">#1A1A2E</item>
        <item name="colorSecondary">#C084FC</item>
        <item name="colorOnSecondary">#1A1A2E</item>
        <item name="android:statusBarColor">#0B0F19</item>
        <item name="android:navigationBarColor">#0B0F19</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Splash Screen Theme (Dark) -->
    <style name="AppTheme.Splash" parent="AppTheme">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="android:windowFullscreen">false</item>
    </style>
</resources>
